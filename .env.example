# Backend Environment Variables
NODE_ENV=development
PORT=5000
# Provide your MongoDB Atlas URI in production, or leave USE_IN_MEMORY_DB=true for zero-config local execution
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/factoryflow?retryWrites=true&w=majority
USE_IN_MEMORY_DB=true

JWT_SECRET=replace-with-a-strong-256-bit-random-secret
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173,https://order-to-audit-system-for-a-small-f.vercel.app,https://order-to-audit-system-for-a-small-food-manufacturer-p6fs4skc2.vercel.app

# Seller / Company Defaults (for GST Invoices)
COMPANY_NAME=FactoryFlow Foods Pvt. Ltd.
COMPANY_GSTIN=33AABCF1234D1Z5
COMPANY_ADDRESS=Plot 42, SIDCO Industrial Estate, Tiruchirappalli, Tamil Nadu - 620015
COMPANY_STATE=Tamil Nadu
COMPANY_STATE_CODE=33
COMPANY_PHONE=+91 431 240 5500
COMPANY_EMAIL=billing@factoryflow.in

# Frontend Environment Variables (frontend/.env)
VITE_API_URL=http://localhost:5000/api
